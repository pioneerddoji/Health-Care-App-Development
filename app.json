{
  "expo": {
    "name": "케어노트",
    "slug": "carenote",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "carenote",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.carenote.mvp",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "증상·처방전 등 기록 사진을 첨부하기 위해 사진 보관함에 접근합니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.carenote.mvp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F2"
      },
      "permissions": ["READ_MEDIA_IMAGES", "POST_NOTIFICATIONS"]
    },
    "plugins": ["expo-notifications"],
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    }
  }
}
