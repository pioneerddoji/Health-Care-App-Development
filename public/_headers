# Cloudflare Pages 응답 헤더 — 이 파일은 빌드 출력 루트로 그대로 복사된다.
#
# 건강 기록을 다루는 앱이라 기본 방어선은 깔고 간다. 다만 **CSP 는 일부러 넣지
# 않았다** — Supabase(REST/Realtime/Storage 서명 URL), 소셜 로그인 팝업,
# data: URI 이미지가 얽혀 있어 잘못 쓰면 앱이 조용히 깨진다. 실배포에서 실제
# 요청 목록을 확인한 뒤 connect-src 를 좁히는 순서가 맞다. (docs/06 참조)

/*
  # 클릭재킹 방지 — 이 앱이 남의 iframe 안에서 렌더되면 안 된다
  X-Frame-Options: DENY
  # MIME 스니핑 금지
  X-Content-Type-Options: nosniff
  # 외부로 나갈 때 경로·쿼리를 흘리지 않는다 (공유 링크 토큰 유출 방지)
  Referrer-Policy: strict-origin-when-cross-origin
  # 쓰지 않는 기기 권한은 애초에 차단
  Permissions-Policy: geolocation=(), microphone=(), payment=()
  # HTTPS 고정 (Cloudflare 가 인증서를 관리한다)
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# 해시가 박힌 정적 자산은 영구 캐시 — 내용이 바뀌면 파일명이 바뀐다
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

# 진입점은 캐시하지 않는다 — 새 배포가 즉시 반영돼야 한다
/index.html
  Cache-Control: no-cache
