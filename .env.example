# Supabase 연동 시 app.json extra 또는 EAS secret으로 주입
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 페이월 동작 모드 (미지정 시 mock=demo, supabase=hidden) — src/services/billing.ts
# demo: 결제 없이 즉시 전환 체험 / hidden: 전환 버튼 숨김 / live: 실결제(RevenueCat 연동 후)
EXPO_PUBLIC_PAYWALL_MODE=

# 회원가입 문자 인증 모드 (미지정 시 mock=demo, supabase=off) — src/services/smsAuth.ts
# demo: 인증번호를 화면에 표시 / off: 문자 인증 건너뜀(이메일 확인만) / live: 실발송(공급자 연동 후)
EXPO_PUBLIC_SMS_MODE=

# RevenueCat 공개 SDK 키 (PAYWALL_MODE=live일 때만 사용) — src/services/billing.ts
# 대시보드 → API Keys의 public 키. development build 필요(Expo Go 불가)
EXPO_PUBLIC_RC_API_KEY_ANDROID=
EXPO_PUBLIC_RC_API_KEY_IOS=

# 카카오 로그인 버튼 노출 (미지정 시 mock=on, supabase=off) — src/services/socialAuth.ts
# Supabase Kakao provider + Kakao Developers 설정 완료 후 on으로
EXPO_PUBLIC_KAKAO_LOGIN=

# ⚠️ EXPO_PUBLIC_* 값 변경 후 빌드 시 Metro 캐시 주의 — `npx expo export --clear` 필요
